{
  "name": "formpilot",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "test": "node --test packages/*/test/*.test.mjs extension/test/*.test.mjs",
    "test:matcher": "node --test packages/field-matcher/test/index.test.mjs",
    "test:runtime": "node --test packages/form-runtime/test/index.test.mjs",
    "validate:locales": "node scripts/validate-locales.mjs",
    "build": "node scripts/build-extension.mjs",
    "check:build": "node scripts/build-extension.mjs",
    "verify:local-model": "node --test extension/test/ai-runtime.test.mjs",
    "verify:webgpu": "node extension/test/webgpu-verify.mjs",
    "test:browser": "node extension/test/browser-smoke.mjs"
  },
  "devDependencies": {
    "playwright": "1.52.0",
    "vite": "^6.0.0"
  },
  "dependencies": {
    "@huggingface/transformers": "3.7.2"
  }
}
