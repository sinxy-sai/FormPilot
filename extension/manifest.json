{
  "manifest_version": 3,
  "name": "FormPilot",
  "version": "0.3.0",
  "description": "Local AI universal web runtime for reviewable form actions.",
  "permissions": ["storage", "activeTab", "scripting", "sidePanel", "tabs"],
  "host_permissions": ["http://127.0.0.1/*"],
  "action": {"default_title": "FormPilot", "default_icon": {"16": "assets/icon16.png", "32": "assets/icon32.png", "48": "assets/icon48.png"}},
  "icons": {"16": "assets/icon16.png", "32": "assets/icon32.png", "48": "assets/icon48.png", "128": "assets/icon128.png"},
  "background": {"service_worker": "src/background.js", "type": "module"},
  "side_panel": {"default_path": "sidepanel.html"},
  "content_scripts": [{"matches": ["<all_urls>"], "js": ["src/content.js"], "run_at": "document_idle"}]
}
